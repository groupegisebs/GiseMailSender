@model EmailsIndexViewModel
@{ ViewData["Title"] = "Historique des e-mails"; }

<h1 class="mb-4"><i class="bi bi-envelope"></i> Historique des e-mails</h1>

@if (TempData["Success"] is string ok)
{
    <div class="alert alert-success alert-dismissible fade show">@ok<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}
@if (TempData["Error"] is string err)
{
    <div class="alert alert-danger alert-dismissible fade show">@err<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}

<form class="row g-2 mb-3" method="get">
    <div class="col-md-3">
        <select name="status" class="form-select">
            <option value="">Tous les statuts</option>
            @foreach (EmailStatus s in Enum.GetValues<EmailStatus>())
            {
                <option value="@s" selected="@(Model.Status == s.ToString())">@s</option>
            }
        </select>
    </div>
    <div class="col-md-4">
        <input name="search" class="form-control" placeholder="Rechercher par mailCode, sujet, template ou application" value="@Model.Search" />
    </div>
    <div class="col-md-2">
        <button class="btn btn-primary" type="submit">Filtrer</button>
    </div>
</form>

@if (Model.CanPurge)
{
    <form class="row g-2 align-items-end mb-4" asp-action="Purge" method="post"
          onsubmit="return confirm('Supprimer définitivement les e-mails Sent / Failed / Cancelled plus anciens que le délai indiqué ? Les messages encore en file sont conservés.');">
        @Html.AntiForgeryToken()
        <div class="col-md-4">
            <label class="form-label" for="olderThanDays">Nettoyer l’historique (jours à conserver)</label>
            <input id="olderThanDays" name="olderThanDays" type="number" min="14" class="form-control"
                   value="@Model.RetentionDays" />
            <div class="form-text">Les envois Sent, Failed et Cancelled plus anciens sont purgés. Une tâche nocturne fait de même après @Model.RetentionDays jours.</div>
        </div>
        <div class="col-md-3">
            <button type="submit" class="btn btn-outline-danger">Purger les anciens e-mails</button>
        </div>
    </form>
}

<table class="table table-hover bg-white rounded shadow-sm table-sm">
    <thead class="table-light">
        <tr>
            <th>MailCode</th>
            <th>Sujet</th>
            <th>Application</th>
            <th>Template</th>
            <th>Statut</th>
            <th>Date</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Emails.Count == 0)
        {
            <tr>
                <td colspan="7" class="text-muted text-center py-4">Aucun e-mail pour ces filtres.</td>
            </tr>
        }
        else
        {
            @foreach (var m in Model.Emails)
            {
                <tr>
                    <td><code>@m.MailCode</code></td>
                    <td class="text-truncate" style="max-width:200px">@m.Subject</td>
                    <td>@m.ClientApplication?.Name</td>
                    <td>@(m.TemplateCode ?? "—")</td>
                    <td><span class="badge badge-status-@m.Status">@m.Status</span></td>
                    <td class="small">@m.QueuedAt.LocalDateTime.ToString("g")</td>
                    <td><a asp-action="Details" asp-route-id="@m.Id" class="btn btn-sm btn-outline-primary">Détails</a></td>
                </tr>
            }
        }
    </tbody>
</table>

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
    <small class="text-muted">
        @Model.TotalItems e-mail(s) — page @Model.CurrentPage / @Model.TotalPages
        (@Model.PageSize par page)
    </small>
    @if (Model.TotalPages > 1)
    {
        <nav>
            <ul class="pagination mb-0">
                <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : null)">
                    <a class="page-link" asp-action="Index" asp-route-status="@Model.Status" asp-route-search="@Model.Search" asp-route-page="@(Model.CurrentPage - 1)">Précédent</a>
                </li>
                @if (Model.VisiblePages.First() > 1)
                {
                    <li class="page-item">
                        <a class="page-link" asp-action="Index" asp-route-status="@Model.Status" asp-route-search="@Model.Search" asp-route-page="1">1</a>
                    </li>
                    @if (Model.VisiblePages.First() > 2)
                    {
                        <li class="page-item disabled"><span class="page-link">…</span></li>
                    }
                }
                @foreach (var p in Model.VisiblePages)
                {
                    <li class="page-item @(p == Model.CurrentPage ? "active" : null)">
                        <a class="page-link" asp-action="Index" asp-route-status="@Model.Status" asp-route-search="@Model.Search" asp-route-page="@p">@p</a>
                    </li>
                }
                @if (Model.VisiblePages.Last() < Model.TotalPages)
                {
                    @if (Model.VisiblePages.Last() < Model.TotalPages - 1)
                    {
                        <li class="page-item disabled"><span class="page-link">…</span></li>
                    }
                    <li class="page-item">
                        <a class="page-link" asp-action="Index" asp-route-status="@Model.Status" asp-route-search="@Model.Search" asp-route-page="@Model.TotalPages">@Model.TotalPages</a>
                    </li>
                }
                <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : null)">
                    <a class="page-link" asp-action="Index" asp-route-status="@Model.Status" asp-route-search="@Model.Search" asp-route-page="@(Model.CurrentPage + 1)">Suivant</a>
                </li>
            </ul>
        </nav>
    }
</div>
